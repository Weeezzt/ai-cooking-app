# Copy to .env.local (gitignored) and fill in. Never commit real values.

# OpenAI API key — recipe + optional intent calls (AD-6). Server-side only, never logged. Not needed when DATA_SOURCE=fixture.
OPENAI_API_KEY=

# Primat API key — live Swedish grocery data (AD-9). Optional in fixture mode.
PRIMAT_API_KEY=

# Data source: "fixture" (no secrets, no network) or "live" (AD-9). Resolved in src/server/container.ts.
DATA_SOURCE=fixture

# App mode: "demo" uses the labelled Umeå default location; "live" requires a real location (AD-11).
APP_MODE=demo
